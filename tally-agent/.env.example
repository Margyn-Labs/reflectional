# Margyn Tally Agent — optional environment overrides.
# Everything here can also live in the config file (see config.js) written by `pair`.
# Env vars win over the config file when both are set.

# Where Margyn's cloud API lives. Default is production.
MARGYN_API_BASE=https://www.margynlabs.com

# TallyPrime HTTP/XML server. Default localhost:9000.
# Set the IP if Tally runs on a different machine on the LAN.
TALLY_HOST=127.0.0.1
TALLY_PORT=9000

# Exact company name as shown in TallyPrime's "Gateway of Tally" list.
# Required. `pair` will prompt for it if unset.
TALLY_COMPANY=

# Financial year window for the closing-balance / voucher requests (YYYYMMDD).
# Defaults to the current Indian FY (1 Apr – 31 Mar) computed at runtime.
TALLY_FROM_DATE=
TALLY_TO_DATE=

# Poll interval for `run` mode, in minutes. Default 15.
SYNC_INTERVAL_MINUTES=15
